# ─────────────────────────────────────────────────────────────────────────────
# The Talent Mosaic — environment
#
# Copy to `.env.local` and fill in. Every variable here is validated by Zod in
# `src/lib/config/env.ts`; a missing or malformed one fails the production build
# loudly instead of surfacing as `undefined` at runtime.
#
# Adding a variable means editing THREE places: the schema in env.ts, this file,
# and your own .env.local.
# ─────────────────────────────────────────────────────────────────────────────

# ── Public (inlined into the client bundle — never put a secret here) ────────

# Origin of this Next app. Used for metadataBase, OG tags, absolute URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend REST API, including the version prefix.
# Set to /api/proxy to route every request through the Next passthrough handler
# (see src/app/api/README.md for when that is the right call).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Optional. Where Swagger (/docs) and Redoc (/redoc) are served.
# Omit and the app derives it by stripping /api/v1 from the base URL.
# NEXT_PUBLIC_API_DOCS_URL=http://localhost:4000

NEXT_PUBLIC_APP_NAME=The Talent Mosaic

# Master switch for the auth gate.
#   false → every route is publicly reachable and you are signed in as a preview
#           user, so the whole UI is browsable before a backend exists.
#   true  → proxy.ts and <AuthGate> start enforcing; unauthenticated visitors are
#           redirected to /admin/login. No code changes needed to flip this.
# Set this to true as soon as you have a real API.
NEXT_PUBLIC_AUTH_ENABLED=false

# ── Server only (never sent to the browser) ─────────────────────────────────

# Private hostname for server-to-server calls from Route Handlers, e.g. a VPC
# address that skips the public ingress. Falls back to the public URL if unset.
# API_INTERNAL_BASE_URL=http://api.internal:4000/api/v1

# Name of the httpOnly refresh cookie the backend issues. Must match the backend
# and is read by both `proxy.ts` and the /api/auth/session handler.
SESSION_COOKIE_NAME=refresh_token

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE — MongoDB (Tier 1 only: one app, no separate backend)
#
# If you have a separate backend, delete src/lib/db/ and ignore this section.
# See docs/DATABASE.md and src/lib/db/README.md.
# ─────────────────────────────────────────────────────────────────────────────

# Contains your database password. Server-only — there is no version of this
# that belongs in the browser. Keep the password URL-encoded if it was.
# MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=myapp
# MONGODB_POOL_MAX=10

# ─────────────────────────────────────────────────────────────────────────────
# OPPORTUNITIES JOB FEED — server only
#
# Roles are collected from Greenhouse, Lever, Ashby, YC and Hacker News (sources
# in config/ingest-sources.json), read by Claude, and wait in Listing management
# until an admin approves them.
# ─────────────────────────────────────────────────────────────────────────────

# Secret. Without it roles are still collected, read by simple rules instead of
# Claude, and flagged so the admin checks every field.
# ANTHROPIC_API_KEY=sk-ant-...
ROLES_EXTRACT_MODEL=claude-sonnet-5-5

# Secret, 16+ characters. Vercel Cron sends it as "Authorization: Bearer …" to
# /api/ingest/run and /api/ingest/expire (see vercel.json). Unset → both 401.
# CRON_SECRET=

# true → contact details (email, WhatsApp, phone) only reach signed-in members
# and admins — which is nobody until login ships. Keep true on a public URL.
ROLES_CONTACTS_REQUIRE_AUTH=true

# true → anyone with the link can list approved roles (never contact details).
ROLES_PUBLIC_LIST=false
